          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3文字以上で入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3자 이상 입력하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj co najmniej 3 znaków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use pelo menos 3 caracteres."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng ít nhất 3 ký tự."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请至少输入 3 个字符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請至少輸入 3 個字元。"
          }
        }
      }
    },
    "feedback.compose.description_placeholder" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreibe den Kontext, was du erwartet hast und was passiert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe the context, what you expected and what happened."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe el contexto, lo que esperabas y lo que ocurrió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décrivez le contexte, ce que vous attendiez et ce qui s'est passé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संदर्भ, आपकी अपेक्षा और जो हुआ, उसका वर्णन करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrivi il contesto, cosa ti aspettavi e cosa è successo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "状況、期待していたこと、実際に起きたことを書いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상황, 기대한 결과, 실제로 일어난 일을 설명해 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opisz kontekst, czego oczekiwałeś i co się stało."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descreva o contexto, o que você esperava e o que aconteceu."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô tả bối cảnh, điều bạn mong đợi và điều đã xảy ra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描述情境、你的预期以及实际发生的情况。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描述情境、你的預期以及實際發生的情況。"
          }
        }
      }
    },
