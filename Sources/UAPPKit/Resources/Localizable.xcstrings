            "value" : "Melde dich an, um Feedback zu senden, abzustimmen oder zu kommentieren. Du kannst Inhalte ohne Anmeldung ansehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to send feedback, vote or comment. You can keep browsing without signing in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión para enviar comentarios, votar o comentar. Puedes consultar el contenido sin iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous pour envoyer un avis, voter ou commenter. Vous pouvez consulter le contenu sans vous connecter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ीडबैक भेजने, वोट देने या टिप्पणी करने के लिए साइन इन करें। बिना साइन इन किए भी सामग्री देख सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi per inviare feedback, votare o commentare. Puoi consultare i contenuti senza accedere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィードバックの送信、投票、コメントにはログインしてください。ログインせずに内容を閲覧できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피드백을 보내거나 투표하거나 댓글을 달려면 로그인하세요. 로그인하지 않고도 내용을 볼 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się, aby wysłać opinię, głosować lub komentować. Możesz przeglądać treści bez logowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre para enviar feedback, votar ou comentar. Você pode continuar consultando o conteúdo sem entrar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng nhập để gửi phản hồi, bình chọn hoặc bình luận. Bạn vẫn có thể xem nội dung mà không đăng nhập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录以发送反馈、投票或评论。无需登录也可浏览内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登入以傳送回饋、投票或留言。無需登入也可瀏覽內容。"
          }
        }
