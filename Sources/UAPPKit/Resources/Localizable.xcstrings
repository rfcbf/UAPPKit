    "feedback.compose.attachments_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu zwei Bilder. Standortdaten werden vor dem Senden entfernt."
