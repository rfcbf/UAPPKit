{
  "sourceLanguage" : "pt-BR",
  "strings" : {
    "feedback.compose.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile eine Idee, melde ein Problem oder stelle eine Frage. Jedes Detail hilft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share an idea, report a problem or ask a question. Every detail helps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte una idea, informa de un problema o haz una pregunta. Cada detalle ayuda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez une idée, signalez un problème ou posez une question. Chaque détail compte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई विचार साझा करें, समस्या बताएं या सवाल पूछें। हर जानकारी मदद करती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi un'idea, segnala un problema o fai una domanda. Ogni dettaglio aiuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイデアの共有、問題の報告、質問をお寄せください。どんな詳細も役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이디어를 공유하거나 문제를 알리거나 질문해 주세요. 모든 세부 정보가 도움이 됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podziel się pomysłem, zgłoś problem lub zadaj pytanie. Każdy szczegół pomaga."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhe uma ideia, relate um problema ou tire uma dúvida. Cada detalhe ajuda."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chia sẻ ý tưởng, báo cáo sự cố hoặc đặt câu hỏi. Mọi chi tiết đều hữu ích."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分享想法、报告问题或提出疑问。每个细节都有帮助。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分享想法、回報問題或提出疑問。每個細節都有幫助。"
          }
        }
      }
    },
    "feedback.compose.title_placeholder" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasse es in wenigen Worten zusammen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sum it up in a few words"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resúmelo en pocas palabras"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résumez en quelques mots"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ शब्दों में बताएं"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riassumi in poche parole"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短くまとめてください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몇 단어로 요약해 주세요"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opisz to w kilku słowach"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resuma em poucas palavras"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tóm tắt trong vài từ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用几个词概括"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用幾個詞概括"
          }
        }
      }
    },
    "feedback.compose.title_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende mindestens 3 Zeichen."
          }
