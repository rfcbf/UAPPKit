        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अधिकतम दो चित्र। भेजने से पहले स्थान की जानकारी हटा दी जाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
